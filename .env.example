# Signal Stack — Environment Configuration

# Server & Database
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_URL=sqlite:///./data/signal_stack.db

# Crawler Safety & Performance
CRAWLER_USER_AGENT=SignalStackBot/1.0 (+https://github.com/edxso/signal-stack)
CRAWLER_RATE_LIMIT_SECONDS=1.5
CRAWLER_TIMEOUT_SECONDS=12
CRAWLER_MAX_RETRIES=2

# Automation & Scheduling
WEEKLY_BRIEF_CRON=0 6 * * 1
MONTHLY_AUDIT_CRON=0 2 1 * *
TIMEZONE=UTC

# AI Engine Provider (Zero-Cost Guarantee)
# Options: heuristic (default zero-cost offline NLP), gemini, groq, ollama
AI_PROVIDER=heuristic
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
